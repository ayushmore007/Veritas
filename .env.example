# Copy to .env and adjust for your machine
VERITAS_CONFIG=config/default.yaml
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Backend (veritas-api) ---
# Required to bind beyond loopback (phones, Docker). Generate: openssl rand -hex 24
VERITAS_API_KEY=
# 1 = allow scanning private/loopback addresses (lab networks only; off by default = SSRF guard)
VERITAS_ALLOW_PRIVATE_TARGETS=0
# Comma-separated browser origins allowed to call the API (e.g. Expo web dev): http://localhost:8081
VERITAS_CORS_ORIGINS=
# Where the trained model lives (default: models/flow-detector)
VERITAS_MODEL_DIR=
